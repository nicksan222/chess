SUMMARY = "Raspberry Pi firmware"
LICENSE = "MIT"
LIC_FILES_CHKSUM = "file://LICENSE;md5=f82d4c65d86894b2184ce118b8779401"

inherit cargo cargo-update-recipe-crates externalsrc systemd

# Generated by `just firmware-update-crates`; do not edit by hand.
require ${BPN}-crates.inc

# Build straight from the repository checkout instead of a fetched tarball.
FIRMWARE_SOURCE_DIR ??= "${TOPDIR}/../.."
EXTERNALSRC = "${FIRMWARE_SOURCE_DIR}"
EXTERNALSRC_BUILD = "${WORKDIR}/build"
FIRMWARE_APP_DIR = "${EXTERNALSRC}/apps/firmware"

# Build the isolated yocto/ manifest, not the repository workspace.
CARGO_MANIFEST_PATH = "${FIRMWARE_APP_DIR}/yocto/Cargo.toml"
CARGO_LOCK_PATH = "${FIRMWARE_APP_DIR}/yocto/Cargo.lock"
# update_crates scans this directory recursively for Cargo.lock files.
CARGO_LOCK_SRC_DIR = "${FIRMWARE_APP_DIR}/yocto"

# Only scan the firmware app when computing SOURCE_DATE_EPOCH. Scanning the
# whole checkout races rm_work through the CI-mounted .cache/yocto tree.
# do_unpack resets SOURCE_BASEDIR to EXTERNALSRC, so set it again afterwards.
SOURCE_BASEDIR = "${FIRMWARE_APP_DIR}"
python firmware_restore_source_basedir() {
    d.setVar("SOURCE_BASEDIR", d.getVar("FIRMWARE_APP_DIR"))
}
do_unpack[postfuncs] =+ "firmware_restore_source_basedir"

# Install and enable the systemd service. The unit file lives next to this
# recipe rather than in the external source tree, so track its checksum here.
FIRMWARE_SERVICE := "${THISDIR}/files/firmware.service"
SYSTEMD_SERVICE:${PN} = "firmware.service"
SYSTEMD_AUTO_ENABLE:${PN} = "enable"

do_install[file-checksums] += "${FIRMWARE_SERVICE}:True"
do_install:append() {
    install -d "${D}${systemd_system_unitdir}"
    install -m 0644 "${FIRMWARE_SERVICE}" "${D}${systemd_system_unitdir}/firmware.service"
}
