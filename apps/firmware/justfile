set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory() + "/../.."
package := "firmware"
target := "aarch64-unknown-linux-gnu"
cache := root + "/.cache/yocto"
config := root + "/apps/firmware/yocto/kas/firmware.yml"
machine := "raspberrypi0-2w-64"
deploy := cache + "/build/tmp/deploy/images/" + machine
output := root + "/dist/firmware"
kas_image := "ghcr.io/siemens/kas/kas:5.2"
ruff := env_var_or_default("RUFF", "ruff")

default:
    @just --list

# Check the Rust package and Yocto Python.
quality:
    cd "{{ root }}" && cargo fmt --check --package "{{ package }}"
    cd "{{ root }}" && cargo check --package "{{ package }}" --all-targets --all-features
    cd "{{ root }}" && cargo clippy --package "{{ package }}" --all-targets --all-features -- -D warnings
    cd "{{ root }}" && RUSTDOCFLAGS='-D warnings' cargo doc --package "{{ package }}" --no-deps --all-features
    cd "{{ root }}" && {{ ruff }} check apps/firmware/yocto
    cd "{{ root }}" && {{ ruff }} format --check apps/firmware/yocto

# Run every firmware Rust test.
test:
    cd "{{ root }}" && cargo test --package "{{ package }}" --all-targets --all-features

# Run local firmware gates.
check: quality test validate

# Build the firmware application without constructing an OS image.
build:
    cd "{{ root }}" && cargo build --package "{{ package }}" --all-targets --all-features

# Compile and link the complete firmware crate graph for the Pi architecture.
cross-build: _cross-toolchain
    cd "{{ root }}" && CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
        cargo build --locked --release --package "{{ package }}" --target "{{ target }}"
    aarch64-linux-gnu-readelf --file-header \
        "{{ root }}/target/{{ target }}/release/{{ package }}" | grep --quiet 'Machine:.*AArch64'

[private]
_cross-toolchain:
    @command -v aarch64-linux-gnu-gcc >/dev/null || { echo 'error: the AArch64 GCC linker is required; use the development container' >&2; exit 1; }
    @command -v aarch64-linux-gnu-readelf >/dev/null || { echo 'error: AArch64 binutils are required; use the development container' >&2; exit 1; }
    @target_libdir="$(rustc --target '{{ target }}' --print target-libdir)"; compgen -G "$target_libdir/libstd-*.rlib" >/dev/null || { echo 'error: the Rust AArch64 target is required; use the development container' >&2; exit 1; }

# Validate crate metadata consumed by BitBake.
validate:
    cd "{{ root }}" && python3 apps/firmware/yocto/validate_crates.py

# Parse BitBake and dry-run the complete image task graph without executing it.
image-check: validate _docker
    mkdir -p "{{ cache }}"
    docker run --rm --init --user root \
        -e "USER_ID=$(id -u)" -e "GROUP_ID=$(id -g)" \
        -e KAS_WORK_DIR=/build -e "FIRMWARE_SOURCE_DIR={{ root }}" \
        -v "{{ root }}:{{ root }}" -v "{{ cache }}:/build" -w "{{ root }}" \
        {{ kas_image }} shell -c 'bitbake -n firmware-image' "{{ config }}"

# Build and collect the flashable Yocto image.
image: validate _docker
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{ cache }}"
    docker run --rm --init --user root \
        -e "USER_ID=$(id -u)" -e "GROUP_ID=$(id -g)" \
        -e KAS_WORK_DIR=/build -e "FIRMWARE_SOURCE_DIR={{ root }}" \
        -v "{{ root }}:{{ root }}" -v "{{ cache }}:/build" -w "{{ root }}" \
        {{ kas_image }} build "{{ config }}"
    firmware="{{ deploy }}/firmware-image-{{ machine }}.rootfs.wic.xz"
    bmap="{{ deploy }}/firmware-image-{{ machine }}.rootfs.wic.bmap"
    [[ -e "$firmware" ]] || { echo "error: firmware image is absent from {{ deploy }}" >&2; exit 1; }
    [[ -e "$bmap" ]] || { echo "error: firmware block map is absent from {{ deploy }}" >&2; exit 1; }
    rm -rf "{{ output }}"
    mkdir -p "{{ output }}"
    cp "$firmware" "{{ output }}/firmware-rpi-zero-2w.img.xz"
    cp "$bmap" "{{ output }}/firmware-rpi-zero-2w.bmap"
    (cd "{{ output }}" && sha256sum -- * > SHA256SUMS)
    xz --test "{{ output }}/firmware-rpi-zero-2w.img.xz"
    (cd "{{ output }}" && sha256sum --check SHA256SUMS)

[private]
_docker:
    @command -v docker >/dev/null || { echo 'error: Docker is required' >&2; exit 1; }

# Remove this package's Cargo and Yocto output.
clean:
    rm -rf "{{ cache }}" "{{ output }}"
    cd "{{ root }}" && cargo clean --package "{{ package }}"
