#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

if [[ $# -ne 0 ]]; then
    printf 'Usage: ./tools/cad\n' >&2
    exit 2
fi

domain_dir=hardware/cad
blender_version="4.5.13"
blender_archive="blender-${blender_version}-linux-x64.tar.xz"
blender_sha256="da4e69b06b75b9e642d106496c50e7e240218b411d2f6e18271c1d1d819cef91"
blender_url="https://download.blender.org/release/Blender4.5/${blender_archive}"
cache_root="${repository_root}/.cache/blender"
archive_path="${cache_root}/${blender_archive}"
cached_blender="${cache_root}/blender-${blender_version}-linux-x64/blender"
blender_bin=""

# shellcheck source=tools/lib/pipeline.sh
source tools/lib/pipeline.sh

setup() {
    if [[ -z "${BLENDER_BIN:-}" && -x /opt/blender/blender ]]; then
        BLENDER_BIN=/opt/blender/blender
    fi

    if [[ -n "${BLENDER_BIN:-}" ]]; then
        if [[ ! -x "${BLENDER_BIN}" ]]; then
            printf 'BLENDER_BIN is not executable: %s\n' "${BLENDER_BIN}" >&2
            return 1
        fi
        blender_bin="${BLENDER_BIN}"
        return 0
    fi

    if [[ "$(uname -m)" != "x86_64" ]]; then
        printf 'Automatic Blender setup supports Linux x86_64 only. Set BLENDER_BIN.\n' >&2
        return 1
    fi

    mkdir -p "${cache_root}"
    if [[ ! -x "${cached_blender}" ]]; then
        if [[ ! -f "${archive_path}" ]]; then
            printf 'Downloading Blender %s LTS...\n' "${blender_version}" >&2
            curl --fail --location --retry 3 --show-error \
                --output "${archive_path}" "${blender_url}"
        fi
        printf '%s  %s\n' "${blender_sha256}" "${archive_path}" | sha256sum --check --status
        tar -xf "${archive_path}" -C "${cache_root}"
    fi
    blender_bin="${cached_blender}"
}

run_tests() {
    printf '\n==> Validate cad dimensions\n'
    python3 "${domain_dir}/core/dimensions.py"
    printf '\n==> Test cad\n'
    python3 -m unittest discover -s "${domain_dir}/tests"
}

generate() {
    mkdir -p "${domain_dir}/generated"
    find "${domain_dir}/generated" -maxdepth 1 -type f ! -name README.md -delete
    local blender generator
    blender=("${blender_bin}" --background --factory-startup --gpu-backend opengl)
    if [[ -z "${DISPLAY:-}" ]] && command -v xvfb-run >/dev/null 2>&1; then
        blender=(xvfb-run --auto-servernum "${blender[@]}")
    fi
    while IFS= read -r generator; do
        printf '\n==> Generate %s\n' "$(dirname -- "${generator}")"
        "${blender[@]}" --python "${generator}"
    done < <(list_projects)
}

setup
run_tests
generate
