#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

if [[ $# -ne 0 ]]; then
    printf 'Usage: ./tools/rust\n' >&2
    exit 2
fi

printf '\n==> Format host workspace\n'
cargo fmt --check
printf '\n==> Format firmware application\n'
cargo fmt --manifest-path apps/firmware/Cargo.toml --check
printf '\n==> Type-check host workspace\n'
cargo check --workspace --all-targets
printf '\n==> Lint host workspace\n'
cargo clippy --workspace --all-targets -- -D warnings
printf '\n==> Test host workspace\n'
cargo test --workspace --all-targets
