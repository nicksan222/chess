#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

usage() {
    printf 'Usage: ./tools/rust [quality | test <package>]\n' >&2
    exit 2
}

quality() {
    printf '\n==> Format workspace\n'
    cargo fmt --check
    printf '\n==> Type-check workspace\n'
    cargo check --workspace --all-targets
    printf '\n==> Lint workspace\n'
    cargo clippy --workspace --all-targets -- -D warnings
    printf '\n==> Document workspace\n'
    RUSTDOCFLAGS='-D warnings' cargo doc --workspace --no-deps
}

test_workspace() {
    printf '\n==> Test workspace\n'
    cargo test --workspace --all-targets
}

test_package() {
    printf '\n==> Test package %s\n' "$1"
    cargo test --package "$1" --all-targets
}

case "$#:${1:-}" in
    0:)
        quality
        test_workspace
        ;;
    1:quality)
        quality
        ;;
    2:test)
        test_package "$2"
        ;;
    *)
        usage
        ;;
esac
