#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

domain_dir=hardware/electronics
venv_dir="${repository_root}/.cache/electronics"

# shellcheck source=tools/lib/pipeline.sh
source tools/lib/pipeline.sh

setup() {
    mkdir -p "${repository_root}/.cache/matplotlib"
    export MPLBACKEND=Agg
    export MPLCONFIGDIR="${repository_root}/.cache/matplotlib"
    if [[ ! -x "${venv_dir}/bin/python" ]]; then
        printf 'creating %s\n' "${venv_dir}" >&2
        python3 -m venv "${venv_dir}"
    fi
    if ! "${venv_dir}/bin/python" -c "import schemdraw, matplotlib" > /dev/null 2>&1; then
        "${venv_dir}/bin/pip" install --quiet -r "${domain_dir}/requirements.txt"
    fi
    export PATH="${venv_dir}/bin:${PATH}"
}

run_tests() {
    printf '\n==> Test electronics\n'
    python3 -m unittest discover -s "${domain_dir}/tests"
}

generate() {
    mkdir -p "${domain_dir}/generated"
    find "${domain_dir}/generated" -maxdepth 1 -type f ! -name README.md -delete
    local generator
    while IFS= read -r generator; do
        printf '\n==> Generate %s\n' "$(dirname -- "${generator}")"
        python3 "${generator}"
    done < <(list_projects)
    printf '\n==> Bill of materials\n'
    python3 "${domain_dir}/core/bom.py"
}

if [[ $# -eq 0 ]]; then
    setup
    run_tests
    generate
    exit 0
fi

case "$1" in
    list) list_projects ;;
    setup) setup ;;
    check)
        setup
        run_tests
        ;;
    build | generate)
        setup
        generate
        ;;
    help | -h | --help)
        cat <<EOF
Usage: ./tools/electronics [command]

With no command, does the full job: install Schemdraw if needed, test, generate.

Commands:
  (default)  Setup, test, then generate
  list       Show project generate.py files in dependency order
  setup      Install the toolchain only
  check      Setup and run tests
  build      Setup and generate
  help       Show this message
EOF
        ;;
    *)
        printf 'error: unknown electronics command: %s\n' "$1" >&2
        exit 2
        ;;
esac
