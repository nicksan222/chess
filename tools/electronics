#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

readonly venv_dir="${repository_root}/.cache/electronics"
readonly requirements=hardware/electronics/requirements.txt
readonly electronics_dir=hardware/electronics

usage() {
    cat <<'EOF'
Usage: ./tools/electronics <command>

Commands:
  list      Show project generate.py files in order.
  build     Run every project generator, then rebuild the component list.
  generate  Same as build.
  check     Build, then run the electronics tests.

Python is the source of truth. Schemdraw draws every project in
hardware/electronics/projects/ to <project>.svg and .png at the top of
hardware/electronics, and counts the placed symbols into bom.md beside them.
The first run creates .cache/electronics and pip-installs
hardware/electronics/requirements.txt.
EOF
}

discover_generators() {
    local generator order order_file
    while IFS= read -r -d '' generator; do
        order_file="$(dirname -- "${generator}")/generation-order"
        order=100
        if [[ -f "${order_file}" ]]; then
            IFS= read -r order < "${order_file}" || true
        fi
        if [[ ! "${order}" =~ ^[0-9]+$ ]]; then
            printf 'Invalid generation order in %s: %s\n' \
                "${order_file}" "${order}" >&2
            return 1
        fi
        printf '%09d\t%s\n' "${order}" "${generator}"
    done < <(find hardware/electronics -type f -name generate.py -print0)
}

sorted_generators() {
    local manifest
    manifest="$(mktemp)"
    discover_generators | LC_ALL=C sort > "${manifest}"
    if [[ ! -s "${manifest}" ]]; then
        rm -f "${manifest}"
        printf 'No electronics project generators found.\n' >&2
        return 1
    fi
    cat "${manifest}"
    rm -f "${manifest}"
}

ensure_python() {
    mkdir -p "${repository_root}/.cache/matplotlib"
    export MPLBACKEND=Agg
    export MPLCONFIGDIR="${repository_root}/.cache/matplotlib"
    if [[ ! -x "${venv_dir}/bin/python" ]]; then
        python3 -m venv "${venv_dir}"
    fi
    if ! "${venv_dir}/bin/python" -c "import schemdraw, matplotlib" >/dev/null 2>&1; then
        "${venv_dir}/bin/pip" install -r "${requirements}"
    fi
    export PATH="${venv_dir}/bin:${PATH}"
}

build() {
    ensure_python
    local order generator
    # Generated artefacts live at the top of hardware/electronics; clear them so
    # a removed project cannot leave a stale drawing behind.
    find "${electronics_dir}" -maxdepth 1 \
        \( -name '*.svg' -o -name '*.png' -o -name 'bom.md' \) -delete
    while IFS=$'\t' read -r order generator; do
        printf '\n==> Generate %s\n' "$(dirname -- "${generator}")"
        python3 "${generator}"
    done < <(sorted_generators)
    printf '\n==> Bill of materials\n'
    python3 "${electronics_dir}/core/bom.py"
}

python_tests() {
    ensure_python
    python3 -m unittest discover -s hardware/electronics/tests
}

check() {
    if [[ "${1:-}" == --allow-missing ]]; then
        shift
    fi
    build
    python_tests
}

command_name="${1:-}"
shift || true
case "${command_name}" in
    list) sorted_generators ;;
    build | generate) build ;;
    check) check "$@" ;;
    help | -h | --help | "") usage ;;
    *)
        printf 'error: unknown electronics command: %s\n' "${command_name}" >&2
        usage >&2
        exit 2
        ;;
esac
