#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

if [[ $# -ne 0 ]]; then
    printf 'Usage: ./tools/python\n' >&2
    exit 2
fi

ruff_version="0.16.5"
python_roots=(apps/firmware/yocto hardware/cad hardware/pcb hardware/shared)

run_ruff() {
    if command -v ruff >/dev/null 2>&1 \
        && [[ "$(ruff --version)" == "ruff ${ruff_version}" ]]; then
        ruff "$@"
        return
    fi
    if command -v uvx >/dev/null 2>&1; then
        uvx "ruff@${ruff_version}" "$@"
        return
    fi
    printf 'error: ruff %s is required for hardware Python\n' \
        "${ruff_version}" >&2
    printf 'install it with: pip install ruff==%s\n' "${ruff_version}" >&2
    return 1
}

printf '\n==> Lint Python\n'
run_ruff check "${python_roots[@]}"
printf '\n==> Format Python\n'
run_ruff format --check "${python_roots[@]}"
