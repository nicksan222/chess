#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

run_check() {
    local label="$1"
    shift

    printf '\n==> %s\n' "${label}"
    "$@"
}

run_check "Rust" ./tools/rust
run_check "CAD" ./tools/cad
run_check "Electronics" ./tools/electronics
