#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repository_root}"

case "$#:${1:-}" in
    0:|1:--check) ;;
    *)
        printf 'Usage: ./tools/firmware-pins [--check]\n' >&2
        exit 2
        ;;
esac

if python3 -c 'import pcbnew' 2>/dev/null; then
    exec python3 hardware/pcb/generate_firmware_pins.py "$@"
fi

kicad_image="${KICAD_IMAGE:-chess-kicad:latest}"
if command -v docker >/dev/null 2>&1 \
    && docker image inspect "${kicad_image}" >/dev/null 2>&1; then
    exec docker run --rm \
        --user "$(id -u):$(id -g)" \
        --env HOME=/tmp \
        --volume "${repository_root}:/workspace" \
        --workdir /workspace \
        --entrypoint python3 \
        "${kicad_image}" \
        hardware/pcb/generate_firmware_pins.py "$@"
fi

printf 'error: KiCad 9 with its Python pcbnew module is required\n' >&2
printf 'run inside the development container or provide KICAD_IMAGE\n' >&2
exit 1
