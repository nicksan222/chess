#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cache="${root}/.cache/yocto"
config="${root}/apps/firmware/yocto/kas/firmware.yml"
machine="raspberrypi0-2w-64"

usage() {
    echo 'Usage: ./tools/firmware [check | build | clean]' >&2
    exit 2
}

run_kas() {
    command -v docker >/dev/null 2>&1 || {
        echo 'error: Docker is required' >&2
        exit 1
    }
    mkdir -p "${cache}"
    docker run --rm --init --user root \
        -e "USER_ID=$(id -u)" -e "GROUP_ID=$(id -g)" \
        -e KAS_WORK_DIR=/build -e "FIRMWARE_SOURCE_DIR=${root}" \
        -v "${root}:${root}" -v "${cache}:/build" -w "${root}" \
        ghcr.io/siemens/kas/kas:5.2 "$@"
}

collect() {
    local deploy output firmware bmap
    deploy="${cache}/build/tmp/deploy/images/${machine}"
    output="${root}/dist/firmware"
    firmware="$(find "${deploy}" -maxdepth 1 -type f -name 'firmware-image-*.rootfs.wic.xz' -print -quit)"
    bmap="$(find "${deploy}" -maxdepth 1 -type f -name 'firmware-image-*.rootfs.wic.bmap' -print -quit)"
    rm -rf "${output}"
    mkdir -p "${output}"
    cp "${firmware}" "${output}/firmware-rpi-zero-2w.img.xz"
    cp "${bmap}" "${output}/firmware-rpi-zero-2w.bmap"
    (cd "${output}" && sha256sum -- * > SHA256SUMS)
}

case "${1:-}" in
    check)
        run_kas shell -c 'bitbake -p' "${config}"
        ;;
    build)
        run_kas build "${config}"
        collect
        ;;
    clean)
        rm -rf "${cache}" "${root}/dist/firmware"
        ;;
    *) usage ;;
esac
