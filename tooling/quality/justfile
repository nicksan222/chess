set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory() + "/../.."

# vtk 9.3.1 (PYSEC-2025-224..226) is pinned exactly by cadquery-ocp 7.8, which
# cadquery 2.6 requires; the fix needs cadquery 2.8 and a verified `just cad`.

pip_audit_ignored := "--ignore-vuln PYSEC-2025-224 --ignore-vuln PYSEC-2025-225 --ignore-vuln PYSEC-2025-226"

default:
    @just --list

# Repository rules no compiler or linter covers: patterns, boundaries, shell, workflows, text.
quality: patterns boundaries shell workflows spelling editorconfig

# Test every ast-grep rule against its examples, then scan the repository.
patterns:
    cd "{{ root }}" && ast-grep test --skip-snapshot-tests
    cd "{{ root }}" && ast-grep scan

# Shell scripts and the Git hook (ShellCheck).
shell:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    git ls-files --cached --others --exclude-standard -z '*.sh' .githooks/pre-commit | \
        while IFS= read -r -d '' path; do
            if [[ -f "$path" ]]; then printf '%s\0' "$path"; fi
        done | xargs -0 --no-run-if-empty shellcheck

# GitHub Actions workflows, including their `run:` scripts through ShellCheck (actionlint).
workflows:
    cd "{{ root }}" && actionlint
    cd "{{ root }}" && bash .github/scripts/changed-scopes-test.sh

# Spelling in code, comments and docs (typos.toml).
spelling:
    cd "{{ root }}" && typos

# Encoding, line endings, final newlines, trailing whitespace and tabs in tracked files (.editorconfig).
editorconfig:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    git ls-files --cached --others --exclude-standard -z | \
        while IFS= read -r -d '' path; do
            if [[ -f "$path" ]]; then printf '%s\0' "$path"; fi
        done | xargs -0 --no-run-if-empty editorconfig-checker

# Crate boundaries: deny.toml wrappers (some unused in the smaller Yocto graph), then each portable crate as sole root.
boundaries:
    cd "{{ root }}" && cargo deny --locked --config deny.toml check bans
    cd "{{ root }}" && cargo deny --locked --config deny.toml --manifest-path apps/firmware/yocto/Cargo.toml check bans --allow unused-wrapper
    cd "{{ root }}" && for manifest in crates/*/Cargo.toml; do cargo deny --locked --config tooling/quality/portable.deny.toml --manifest-path "$manifest" check bans; done

# Advisories, licences, bans and sources for both Cargo lockfiles; fetches the advisory database.
deny:
    cd "{{ root }}" && cargo deny --locked --config deny.toml check
    cd "{{ root }}" && cargo deny --locked --config deny.toml --manifest-path apps/firmware/yocto/Cargo.toml check --allow unused-wrapper

# Networked checks when the offline quality gate already covered bans.
audit:
    cd "{{ root }}" && cargo deny --locked --config deny.toml check advisories licenses sources
    cd "{{ root }}" && cargo deny --locked --config deny.toml --manifest-path apps/firmware/yocto/Cargo.toml check advisories licenses sources --allow unused-wrapper

# Unused or misplaced Rust dependencies, from the sources without compiling.
unused-dependencies:
    cd "{{ root }}" && cargo shear

# Known vulnerabilities in the development container's pinned Python tools; queries PyPI.
python-audit:
    cd "{{ root }}" && pip-audit --requirement .devcontainer/requirements.txt --no-deps --progress-spinner off {{ pip_audit_ignored }}

# Every dependency check; needs network access for advisories.
dependencies: deny unused-dependencies python-audit

# Run every quality gate.
check: quality audit unused-dependencies python-audit
