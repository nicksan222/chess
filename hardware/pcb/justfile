set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory() + "/../.."

# Board-as-code generation and checks. Python owns the pipeline, not shell DAGs.
default:
    @just --list

generate:
    cd "{{ root }}" && PYTHONPATH=hardware python3 -m pcb generate

check:
    cd "{{ root }}" && PYTHONPATH=hardware python3 -m pcb check

review:
    cd "{{ root }}" && PYTHONPATH=hardware python3 -m pcb review

release:
    cd "{{ root }}" && PYTHONPATH=hardware python3 -m pcb release

# Root/CI entry point.
quality: check

clean:
    find "{{ root }}/hardware/pcb" -type d -name __pycache__ -prune -exec rm -rf {} +
    rm -f "{{ root }}/hardware/pcb/generated/"*.kicad_prl "{{ root }}/hardware/pcb/generated/"~*.lck
