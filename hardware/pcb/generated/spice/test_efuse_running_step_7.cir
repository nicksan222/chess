RLOAD out 0 78.125
.tran 10u 100.0m 0 10u uic
.control
run
meas tran result_rail_before FIND v(out) AT=39m
meas tran trip WHEN v(xu74.ov)=0.5 RISE=1
let result_trip_ms = (trip - 40m) * 1000
meas tran result_rail_peak MAX v(out) FROM=40m TO=100m
meas tran over_start WHEN v(out)=5.5 RISE=1
meas tran over_end WHEN v(out)=5.5 FALL=1
let result_over_ms = (over_end - over_start) * 1000
print result_trip_ms result_over_ms
if result_rail_before < 4.9
echo "ASSERTION FAILED: result_rail_before below 4.9"
quit 1
end
if result_rail_before > 5
echo "ASSERTION FAILED: result_rail_before above 5"
quit 1
end
if result_trip_ms < 0
echo "ASSERTION FAILED: result_trip_ms below 0"
quit 1
end
if result_trip_ms > 2
echo "ASSERTION FAILED: result_trip_ms above 2"
quit 1
end
if result_rail_peak < 5.5
echo "ASSERTION FAILED: result_rail_peak below 5.5"
quit 1
end
if result_rail_peak > 6.1
echo "ASSERTION FAILED: result_rail_peak above 6.1"
quit 1
end
if result_over_ms < 0
echo "ASSERTION FAILED: result_over_ms below 0"
quit 1
end
if result_over_ms > 12
echo "ASSERTION FAILED: result_over_ms above 12"
quit 1
end
quit 0
.endc
.end
