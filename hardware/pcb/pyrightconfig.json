{
  "include": [
    "*.py",
    "definition",
    "tests",
    "../shared/components",
    "../shared/electronics"
  ],
  "extraPaths": [
    ".."
  ],
  "stubPath": "typings",
  "pythonVersion": "3.12",
  "typeCheckingMode": "strict",
  "reportAny": "error",
  "reportExplicitAny": "error",
  "executionEnvironments": [
    {
      "root": "tests",
      "reportPrivateUsage": "none"
    },
    {
      "root": "."
    }
  ]
}
