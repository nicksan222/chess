set shell := ["bash", "-euo", "pipefail", "-c"]

root := justfile_directory() + "/../.."

default:
    @just --list

# Lint and format-check CAD Python.
quality:
    cd "{{ root }}" && ruff check hardware/cad
    cd "{{ root }}" && ruff format --check hardware/cad
    cd "{{ root }}" && basedpyright --project hardware/cad/pyrightconfig.json

# Run CAD unit tests.
test:
    cd "{{ root }}" && python3 -m pytest hardware/cad/board/tests
    cd "{{ root }}" && PYTHONPATH=hardware python3 -m unittest discover -s hardware/cad/harness -t hardware -p '*_test.py'

# Regenerate printable components and assemble their exact saved meshes.
generate:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{ root }}"
    blender="${BLENDER_BIN:-/opt/blender/blender}"
    [[ -x "$blender" ]] || { echo 'error: use the development container or set BLENDER_BIN to an executable' >&2; exit 1; }
    PYTHONPATH=hardware python3 -m cad.board.generate "$blender"

# Run checks without invoking Blender.
check-fast: quality test
    just --justfile "{{ root }}/hardware/shared/justfile" validate

# Run all CAD checks and regenerate output.
check: check-fast generate

# Remove local Python caches.
clean:
    find "{{ root }}/hardware/cad" -type d -name __pycache__ -prune -exec rm -rf {} +
