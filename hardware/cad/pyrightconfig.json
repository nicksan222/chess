{
  "include": [
    "*.py",
    "../build_support.py",
    "board",
    "components",
    "harness"
  ],
  "extraPaths": [
    ".."
  ],
  "stubPath": "../pcb/harness/typings",
  "pythonVersion": "3.12",
  "typeCheckingMode": "strict",
  "reportAny": "error",
  "reportExplicitAny": "error",
  "executionEnvironments": [
    {
      "root": "components",
      "extraPaths": [
        ".",
        ".."
      ],
      "reportAttributeAccessIssue": "none",
      "reportUnknownArgumentType": "none",
      "reportUnknownMemberType": "none",
      "reportUnknownVariableType": "none"
    },
    {
      "root": "harness/base/blender",
      "extraPaths": [
        ".",
        ".."
      ],
      "reportAttributeAccessIssue": "none",
      "reportUnknownArgumentType": "none",
      "reportUnknownMemberType": "none",
      "reportUnknownVariableType": "none"
    },
    {
      "root": "board",
      "extraPaths": [
        ".",
        ".."
      ],
      "reportAttributeAccessIssue": "none",
      "reportUnknownArgumentType": "none",
      "reportUnknownMemberType": "none",
      "reportUnknownVariableType": "none"
    },
    {
      "root": ".",
      "extraPaths": [
        ".",
        ".."
      ]
    }
  ]
}
