# of extension (including schematics, DRC reports, renders and CAD previews).
/hardware/pcb/generated/
/hardware/pcb/definition/output/
/hardware/cad/generated/
*.blend1
*.blend2
__pycache__/
*.py[cod]
.cache/

# Agent credentials/configuration overrides stay local.
.claude/settings.local.json
/.codex/
/dist/firmware/
