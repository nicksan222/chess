/target/
**/target/
.env
.env.*
.DS_Store
.idea/
.vscode/
.venv/
*.swp
*.tmp
*.kicad_prl
*.filled.kicad_pro
# Ignore standalone simulation/native scratch output.
# Official PCB exports are versioned below.
*.kicad_pcb
*.kicad_pro
*.cir
# Keep the complete generated PCB project and fabrication package in Git.
!/hardware/pcb/generated/*.kicad_pcb
!/hardware/pcb/generated/*.kicad_pro
# CAD models, renders and validation manifests are versioned with their sources.
*.blend1
*.blend2
__pycache__/
*.py[cod]
.cache/

# Agent credentials/configuration overrides stay local.
.claude/settings.local.json
/.codex/
/dist/firmware/
